# ==============================================================================
# LOCAL AI EXAM PORTAL - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env.local and fill in your values:
# cp .env.example .env.local
# ==============================================================================

# 1. Google Gemini Cloud API Key
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Local Ollama Server Endpoint
OLLAMA_ENDPOINT=http://127.0.0.1:11434

# 3. Default AI Provider ("ollama" or "gemini")
NEXT_PUBLIC_DEFAULT_PROVIDER=ollama

# 4. Local Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
